<Window x:Class="CaptionTranslator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Caption Translator"
        Width="620"
        Height="460"
        MinWidth="520"
        MinHeight="380">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="12" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="12" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Orientation="Horizontal">
      <Button x:Name="SelectRegionButton" Padding="14,7" Click="SelectRegionButton_Click">Selecionar area</Button>
      <Button x:Name="StartButton" Margin="8,0,0,0" Padding="14,7" Click="StartButton_Click" IsEnabled="False">Iniciar</Button>
      <Button x:Name="StopButton" Margin="8,0,0,0" Padding="14,7" Click="StopButton_Click" IsEnabled="False">Parar</Button>
      <TextBlock x:Name="StatusText" Margin="16,0,0,0" VerticalAlignment="Center">Selecione a area das legendas.</TextBlock>
    </StackPanel>

    <Border Grid.Row="2" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="12">
      <TextBlock x:Name="RegionText" TextWrapping="Wrap">Nenhuma area configurada.</TextBlock>
    </Border>

    <Grid Grid.Row="4">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <TextBlock FontWeight="SemiBold">Legenda reconhecida (ingles)</TextBlock>
      <TextBox x:Name="SourceText" Grid.Row="1" Margin="0,6,0,14" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
      <TextBlock Grid.Row="2" FontWeight="SemiBold">Traducao (portugues)</TextBlock>
      <TextBox x:Name="TranslationText" Grid.Row="3" Margin="0,6,0,0" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
    </Grid>
  </Grid>
</Window>