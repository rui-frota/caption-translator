<Window x:Class="CaptionTranslator.RegionSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="#22000000"
        WindowState="Maximized"
        Topmost="True"
        ShowInTaskbar="False"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseMove="Window_MouseMove"
        MouseLeftButtonUp="Window_MouseLeftButtonUp">
  <Canvas>
    <Rectangle x:Name="SelectionRectangle" Stroke="#F8FAFC" StrokeThickness="2" Fill="#2222C55E" Visibility="Collapsed" />
    <TextBlock Canvas.Left="20" Canvas.Top="20" Foreground="White" FontSize="18">Arraste sobre a area das legendas. Pressione Esc para cancelar.</TextBlock>
  </Canvas>
</Window>