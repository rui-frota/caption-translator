<Window x:Class="CaptionTranslator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Caption Translator"
        Width="900"
        Height="600"
        MinWidth="680"
        MinHeight="480"
        Background="#F4F7FB"
        FontFamily="Segoe UI"
        Foreground="#172033">
  <Window.Resources>
    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Background" Value="#2563EB" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="16,9" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style x:Key="SecondaryButton" TargetType="Button">
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="#334155" />
      <Setter Property="BorderBrush" Value="#D7DEE9" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="16,9" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#FBFCFE" />
      <Setter Property="BorderBrush" Value="#D7DEE9" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="12" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="VerticalContentAlignment" Value="Top" />
    </Style>
  </Window.Resources>

  <Grid Margin="28">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="20" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid>
      <StackPanel>
        <TextBlock FontSize="25" FontWeight="SemiBold">Caption Translator</TextBlock>
        <TextBlock Margin="0,4,0,0" Foreground="#64748B" FontSize="13">OCR local e traducao em tempo real</TextBlock>
      </StackPanel>
      <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#E7F6EC" CornerRadius="14" Padding="12,6">
        <TextBlock x:Name="StatusText" Foreground="#237A43" FontSize="12" FontWeight="SemiBold">Selecione a area das legendas.</TextBlock>
      </Border>
    </Grid>

    <Border Grid.Row="2" Background="White" BorderBrush="#E1E7F0" BorderThickness="1" CornerRadius="10" Padding="16">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Foreground="#64748B" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center">REGIAO DE CAPTURA</TextBlock>
        <TextBlock x:Name="RegionText" Grid.Column="1" Margin="18,0,18,0" Foreground="#334155" TextWrapping="Wrap" VerticalAlignment="Center">Nenhuma area configurada.</TextBlock>
        <StackPanel Grid.Column="2">
          <StackPanel Orientation="Horizontal">
            <Button x:Name="SelectRegionButton" Style="{StaticResource SecondaryButton}" Click="SelectRegionButton_Click">Selecionar area</Button>
            <Button x:Name="StartButton" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}" Click="StartButton_Click" IsEnabled="False">Iniciar</Button>
            <Button x:Name="StopButton" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Click="StopButton_Click" IsEnabled="False">Parar</Button>
          </StackPanel>
          <StackPanel Margin="0,12,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <CheckBox x:Name="AudioTranslationEnabledCheckBox" VerticalAlignment="Center" Foreground="#334155" Checked="AudioTranslationEnabledCheckBox_Checked" Unchecked="AudioTranslationEnabledCheckBox_Unchecked">Traduzir audio do sistema</CheckBox>
            <CheckBox x:Name="SpeechEnabledCheckBox" VerticalAlignment="Center" Foreground="#334155">Ler traducao</CheckBox>
            <TextBlock Margin="16,0,8,0" VerticalAlignment="Center" Foreground="#64748B" FontSize="12">Volume</TextBlock>
            <Slider x:Name="SpeechVolumeSlider" Width="96" Minimum="0" Maximum="100" Value="70" VerticalAlignment="Center" />
            <TextBlock Margin="16,0,8,0" VerticalAlignment="Center" Foreground="#64748B" FontSize="12">Velocidade</TextBlock>
            <Slider x:Name="SpeechRateSlider" Width="96" Minimum="-5" Maximum="5" Value="0" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <StackPanel Grid.Row="3" Margin="0,0,0,12" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
      <TextBlock Margin="0,0,10,0" VerticalAlignment="Center" Foreground="#64748B" FontSize="12">Tamanho da letra</TextBlock>
      <Slider x:Name="CaptionFontSizeSlider" Width="140" Minimum="12" Maximum="32" Value="14" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
      <TextBlock x:Name="CaptionFontSizeText" Width="36" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="#334155" Text="{Binding Value, ElementName=CaptionFontSizeSlider, StringFormat={}{0:0}}" />
    </StackPanel>

    <Grid Grid.Row="4">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="14" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Background="White" BorderBrush="#E1E7F0" BorderThickness="1" CornerRadius="10" Padding="16">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="8" Height="8" Fill="#F59E0B" VerticalAlignment="Center" />
              <TextBlock Margin="8,0,0,0" FontWeight="SemiBold">Legenda reconhecida</TextBlock>
              <TextBlock Margin="6,0,0,0" Foreground="#94A3B8">ingles</TextBlock>
            </StackPanel>
            <Button x:Name="CopySourceTextButton" Grid.Column="1" MinWidth="76" Padding="10,5" Style="{StaticResource SecondaryButton}" Click="CopySourceTextButton_Click" IsEnabled="False" ToolTip="Copiar texto em ingles">Copiar</Button>
          </Grid>
          <TextBox x:Name="SourceText" Grid.Row="2" FontSize="{Binding Value, ElementName=CaptionFontSizeSlider}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
        </Grid>
      </Border>

      <Border Grid.Row="2" Background="White" BorderBrush="#E1E7F0" BorderThickness="1" CornerRadius="10" Padding="16">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="8" Height="8" Fill="#22C55E" VerticalAlignment="Center" />
              <TextBlock Margin="8,0,0,0" FontWeight="SemiBold">Traducao</TextBlock>
              <TextBlock Margin="6,0,0,0" Foreground="#94A3B8">portugues</TextBlock>
            </StackPanel>
            <Button x:Name="CopyTranslationTextButton" Grid.Column="1" MinWidth="76" Padding="10,5" Style="{StaticResource SecondaryButton}" Click="CopyTranslationTextButton_Click" IsEnabled="False" ToolTip="Copiar traducao em portugues">Copiar</Button>
          </Grid>
          <TextBox x:Name="TranslationText" Grid.Row="2" FontSize="{Binding Value, ElementName=CaptionFontSizeSlider}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>